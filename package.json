{
  "name": "@uni-helper/devtools-monorepo",
  "version": "0.0.1-beta.8",
  "private": true,
  "description": "devtools for uni",
  "keywords": [
    "dx",
    "rollup",
    "transform",
    "unplugin",
    "vite",
    "webpack"
  ],
  "homepage": "https://github.com/uni-helper/devtools#readme",
  "bugs": {
    "url": "https://github.com/uni-helper/devtools/issues"
  },
  "license": "MIT",
  "author": "FliPPeDround <flippedround@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/devtools.git"
  },
  "funding": "https://afdian.com/a/flippedround",
  "type": "module",
  "scripts": {
    "dev": "turbo stub",
    "play": "concurrently -n panel,mp -c cyan,green \"pnpm --filter @uni-helper/devtools-client stub\" \"nodemon\"",
    "build": "turbo build",
    "lint": "oxlint .",
    "lint:fix": "oxfmt .",
    "test": "turbo test",
    "release": "bumpp -r",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "npx simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/ni": "^0.21.12",
    "@dcloudio/types": "^3.4.7",
    "@types/node": "^20.14.2",
    "@types/ungap__structured-clone": "^1.2.0",
    "@ungap/structured-clone": "^1.2.0",
    "@unocss/reset": "^0.59.4",
    "bumpp": "^9.4.1",
    "concurrently": "^8.2.2",
    "consola": "^3.2.3",
    "fast-glob": "^3.3.2",
    "kill-port": "^2.0.1",
    "lint-staged": "^15.2.0",
    "miniprogram-automator": "^0.12.1",
    "nodemon": "^3.1.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^0.9.10",
    "pnpm": "^9.0.2",
    "rimraf": "^5.0.7",
    "simple-git-hooks": "^2.9.0",
    "tsup": "^8.1.0",
    "turbo": "^2.0.4",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "oxfmt"
  },
  "packageManager": "pnpm@9.0.2"
}
