{
  "name": "@uni-helper/devtools-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "devtools for uni",
  "keywords": [
    "dx",
    "rollup",
    "transform",
    "unplugin",
    "vite",
    "webpack"
  ],
  "homepage": "https://github.com/uni-helper/devtools#readme",
  "bugs": {
    "url": "https://github.com/uni-helper/devtools/issues"
  },
  "license": "MIT",
  "author": "FliPPeDround <flippedround@qq.com>",
  "contributors": [
    "DBAAZzz <41032629+DBAAZzz@users.noreply.github.com> (https://github.com/DBAAZzz)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/devtools.git"
  },
  "funding": "https://afdian.com/a/flippedround",
  "type": "module",
  "scripts": {
    "dev": "turbo stub",
    "play": "concurrently -n panel,mp -c cyan,green \"pnpm --filter @uni-helper/devtools-client stub\" \"nodemon\"",
    "build": "turbo build",
    "lint": "oxlint . --ignore-pattern 'packages/core/assets/**' --ignore-pattern 'playground/**'",
    "lint:fix": "oxlint . --fix --ignore-pattern 'packages/core/assets/**' --ignore-pattern 'playground/**'",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "turbo test",
    "release": "bumpp -r",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "npx simple-git-hooks",
    "check:publish": "node scripts/check-publish.mjs"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.7",
    "@types/node": "^20.14.2",
    "bumpp": "^9.4.1",
    "concurrently": "^8.2.2",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.1.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^0.9.10",
    "pnpm": "^9.0.2",
    "simple-git-hooks": "^2.9.0",
    "turbo": "^2.0.4",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "oxfmt"
  },
  "packageManager": "pnpm@9.0.2"
}
