{
  "name": "@uni-helper/devtools-core",
  "version": "0.0.2",
  "description": "Uni DevTools node 侧：DevframeDefinition（含 agent 元数据）+ WebSocket 中继 + Vite Inspect 托管",
  "homepage": "https://github.com/uni-helper/devtools#readme",
  "bugs": "https://github.com/uni-helper/devtools/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/devtools.git",
    "directory": "packages/core"
  },
  "files": [
    "src",
    "assets",
    "dist"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./relay": "./src/relay.ts",
    "./harness": "./src/harness.ts",
    "./inspect-serve": "./src/inspect-serve.ts",
    "./sidecar": "./src/sidecar.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./relay": {
        "types": "./dist/relay.d.ts",
        "default": "./dist/relay.mjs"
      },
      "./sidecar": {
        "types": "./dist/sidecar.d.ts",
        "default": "./dist/sidecar.mjs"
      },
      "./inspect-serve": {
        "types": "./dist/inspect-serve.d.ts",
        "default": "./dist/inspect-serve.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-panel.mjs",
    "prepublishOnly": "pnpm build",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-node.mjs"
  },
  "dependencies": {
    "@uni-helper/devtools-shared": "workspace:*",
    "birpc": "^4.2.0",
    "devframe": "1.1.0",
    "h3": "^2.0.1-rc.32"
  },
  "devDependencies": {
    "@devframes/agentic": "1.1.0",
    "@devframes/hub": "^1.1.0",
    "@devframes/hub-ui": "^1.1.0",
    "@types/node": "^20.14.2",
    "@uni-helper/devtools-client": "workspace:*",
    "tsdown": "^0.23.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
