{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@components/*": ["./src/components/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
